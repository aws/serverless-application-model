{
  "Parameters": {
    "LogGroupName": {
      "Default": "/my-app/scaling-logs",
      "Type": "String"
    }
  },
  "Resources": {
    "CpInheritsGlobal": {
      "Properties": {
        "PermissionsConfig": {
          "CapacityProviderOperatorRoleArn": {
            "Fn::GetAtt": [
              "CpInheritsGlobalOperatorRole",
              "Arn"
            ]
          }
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ],
        "TelemetryConfig": {
          "LoggingConfig": {
            "SystemLogLevel": "INFO"
          }
        },
        "VpcConfig": {
          "SecurityGroupIds": [
            "sg-12345678"
          ],
          "SubnetIds": [
            "subnet-12345678"
          ]
        }
      },
      "Type": "AWS::Lambda::CapacityProvider"
    },
    "CpInheritsGlobalOperatorRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AWSLambdaManagedEC2ResourceOperator"
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "CpOverridesGlobal": {
      "Properties": {
        "PermissionsConfig": {
          "CapacityProviderOperatorRoleArn": {
            "Fn::GetAtt": [
              "CpOverridesGlobalOperatorRole",
              "Arn"
            ]
          }
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ],
        "TelemetryConfig": {
          "LoggingConfig": {
            "LogGroup": {
              "Ref": "ScalingLogs"
            },
            "SystemLogLevel": "DEBUG"
          }
        },
        "VpcConfig": {
          "SecurityGroupIds": [
            "sg-45678901"
          ],
          "SubnetIds": [
            "subnet-45678901"
          ]
        }
      },
      "Type": "AWS::Lambda::CapacityProvider"
    },
    "CpOverridesGlobalOperatorRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AWSLambdaManagedEC2ResourceOperator"
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "CpWithParameterRef": {
      "Properties": {
        "PermissionsConfig": {
          "CapacityProviderOperatorRoleArn": {
            "Fn::GetAtt": [
              "CpWithParameterRefOperatorRole",
              "Arn"
            ]
          }
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ],
        "TelemetryConfig": {
          "LoggingConfig": {
            "LogGroup": {
              "Ref": "LogGroupName"
            },
            "SystemLogLevel": "INFO"
          }
        },
        "VpcConfig": {
          "SecurityGroupIds": [
            "sg-78901234"
          ],
          "SubnetIds": [
            "subnet-78901234"
          ]
        }
      },
      "Type": "AWS::Lambda::CapacityProvider"
    },
    "CpWithParameterRefOperatorRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AWSLambdaManagedEC2ResourceOperator"
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "ScalingLogs": {
      "Properties": {
        "LogGroupName": "/my-app/scaling/my-cp",
        "RetentionInDays": 14
      },
      "Type": "AWS::Logs::LogGroup"
    }
  }
}
