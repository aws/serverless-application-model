{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NetworkConnector with user-provided OperatorRole",
  "Resources": {
    "MyNetworkConnector": {
      "Properties": {
        "OperatorRole": "arn:aws:iam::123456789012:role/CustomOperatorRole",
        "VpcConfig": {
          "NetworkProtocol": "DualStack",
          "SecurityGroupIds": [
            "sg-0abcd0ef"
          ],
          "SubnetIds": [
            "subnet-0abc123"
          ]
        }
      },
      "Type": "AWS::Serverless::NetworkConnector"
    }
  }
}
