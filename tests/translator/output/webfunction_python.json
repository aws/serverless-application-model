{
  "Parameters": {
    "RuntimeParam": {
      "Default": "python3.15",
      "Type": "String"
    }
  },
  "Resources": {
    "PythonWebFunction": {
      "Properties": {
        "FunctionName": {
          "Fn::Sub": [
            "PythonWebFunction-${StackIdSuffix}",
            {
              "StackIdSuffix": {
                "Fn::Select": [
                  0,
                  {
                    "Fn::Split": [
                      "-",
                      {
                        "Fn::Select": [
                          2,
                          {
                            "Fn::Split": [
                              "/",
                              {
                                "Ref": "AWS::StackId"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::Lambda::WebFunction"
    },
    "PythonWebFunctionDefaultEntryPoint": {
      "Properties": {
        "FunctionName": {
          "Fn::Sub": [
            "PythonWebFunctionDefaultEntryPoint-${StackIdSuffix}",
            {
              "StackIdSuffix": {
                "Fn::Select": [
                  0,
                  {
                    "Fn::Split": [
                      "-",
                      {
                        "Fn::Select": [
                          2,
                          {
                            "Fn::Split": [
                              "/",
                              {
                                "Ref": "AWS::StackId"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::Lambda::WebFunction"
    },
    "PythonWebFunctionDefaultEntryPointEndpoint": {
      "DependsOn": [
        "PythonWebFunctionDefaultEntryPoint",
        "PythonWebFunctionDefaultEntryPointRevision"
      ],
      "Properties": {
        "AuthType": "IamAuth",
        "EndpointName": "prod",
        "EndpointType": "HomeRegion",
        "FunctionName": {
          "Ref": "PythonWebFunctionDefaultEntryPoint"
        },
        "RevisionWeights": [
          {
            "RevisionId": {
              "Fn::GetAtt": [
                "PythonWebFunctionDefaultEntryPointRevision",
                "RevisionId"
              ]
            },
            "Weight": 100
          }
        ]
      },
      "Type": "AWS::Lambda::WebFunctionEndpoint"
    },
    "PythonWebFunctionDefaultEntryPointRevision": {
      "DependsOn": [
        "PythonWebFunctionDefaultEntryPoint"
      ],
      "Properties": {
        "BuildConfig": {
          "CodeConfig": {
            "S3Object": {
              "Bucket": "sam-demo-bucket",
              "Key": "webfunc.zip"
            }
          },
          "RuntimeConfig": {
            "Runtime": "python3.15"
          }
        },
        "FunctionName": {
          "Ref": "PythonWebFunctionDefaultEntryPoint"
        },
        "ServiceConfig": {
          "ExecutionRoleArn": {
            "Fn::GetAtt": [
              "PythonWebFunctionDefaultEntryPointRole",
              "Arn"
            ]
          },
          "TimeoutSeconds": 30
        }
      },
      "Type": "AWS::Lambda::WebFunctionRevision",
      "UpdateReplacePolicy": "Retain"
    },
    "PythonWebFunctionDefaultEntryPointRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
