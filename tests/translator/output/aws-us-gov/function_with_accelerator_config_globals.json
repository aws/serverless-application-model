{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Function with AcceleratorConfig in Globals",
  "Resources": {
    "InheritsGlobalsFunction": {
      "Properties": {
        "AcceleratorConfig": {
          "AcceleratorMemorySize": 24
        },
        "CapacityProviderConfig": {
          "LambdaManagedInstancesCapacityProviderConfig": {
            "CapacityProviderArn": {
              "Fn::GetAtt": [
                "MyCapacityProvider",
                "CapacityProviderArn"
              ]
            },
            "PerExecutionEnvironmentMaxConcurrency": 10
          }
        },
        "Code": {
          "ImageUri": "123456789012.dkr.ecr.us-east-1.amazonaws.com/my-gpu-image:latest"
        },
        "MemorySize": 2048,
        "PackageType": "Image",
        "Role": {
          "Fn::GetAtt": [
            "InheritsGlobalsFunctionRole",
            "Arn"
          ]
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::Lambda::Function"
    },
    "InheritsGlobalsFunctionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws-us-gov:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "MyCapacityProvider": {
      "Properties": {
        "CapacityProviderScalingConfig": {
          "MaxVCpuCount": 100,
          "ScalingMode": "Auto"
        },
        "PermissionsConfig": {
          "CapacityProviderOperatorRoleArn": {
            "Fn::GetAtt": [
              "MyCapacityProviderOperatorRole",
              "Arn"
            ]
          }
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ],
        "VpcConfig": {
          "SecurityGroupIds": [
            "sg-12345678"
          ],
          "SubnetIds": [
            "subnet-12345678"
          ]
        }
      },
      "Type": "AWS::Lambda::CapacityProvider"
    },
    "MyCapacityProviderOperatorRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws-us-gov:iam::aws:policy/AWSLambdaManagedEC2ResourceOperator"
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "OverridesAcceleratorFunction": {
      "Properties": {
        "AcceleratorConfig": {
          "AcceleratorMemorySize": 48
        },
        "CapacityProviderConfig": {
          "LambdaManagedInstancesCapacityProviderConfig": {
            "CapacityProviderArn": {
              "Fn::GetAtt": [
                "MyCapacityProvider",
                "CapacityProviderArn"
              ]
            },
            "PerExecutionEnvironmentMaxConcurrency": 10
          }
        },
        "Code": {
          "ImageUri": "123456789012.dkr.ecr.us-east-1.amazonaws.com/my-gpu-image-2:latest"
        },
        "MemorySize": 4096,
        "PackageType": "Image",
        "Role": {
          "Fn::GetAtt": [
            "OverridesAcceleratorFunctionRole",
            "Arn"
          ]
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::Lambda::Function"
    },
    "OverridesAcceleratorFunctionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws-us-gov:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    }
  }
}
