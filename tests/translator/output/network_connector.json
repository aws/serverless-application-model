{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Basic NetworkConnector with auto-generated OperatorRole",
  "Resources": {
    "MyNetworkConnector": {
      "Properties": {
        "Tags": {
          "Environment": "Production",
          "Team": "Platform"
        },
        "VpcConfig": {
